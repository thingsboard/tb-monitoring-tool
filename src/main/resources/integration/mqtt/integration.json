{
  "type": "MQTT",
  "debugMode": false,
  "debugSettings": {
    "failuresEnabled": true,
    "allEnabled": false
  },
  "enabled": true,
  "allowCreateDevicesOrAssets": false,
  "defaultConverterId": null,
  "downlinkConverterId": null,
  "routingKey": null,
  "configuration": {
    "clientConfiguration": {
      "host": "%1$s",
      "port": %2$s,
      "cleanSession": true,
      "retainedMessage": false,
      "ssl": false,
      "connectTimeoutSec": 10,
      "clientId": "mon-int-%4$s",
      "maxBytesInMessage": 32368,
      "protocolVersion": "MQTT_3_1_1",
      "credentials": {
        "type": "basic",
        "username": "%5$s",
        "password": ""
      }
    },
    "topicFilters": [
      {
        "filter": "monitoring/%3$s",
        "qos": 1
      }
    ],
    "downlinkTopicPattern": "${topic}",
    "metadata": {}
  },
  "additionalInfo": null,
  "edgeTemplate": false,
  "remote": false
}
