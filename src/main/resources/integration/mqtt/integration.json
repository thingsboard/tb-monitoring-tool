{
  "type": "MQTT",
  "debugMode": false,
  "debugSettings": {
    "failuresEnabled": true,
    "allEnabled": false
  },
  "enabled": true,
  "allowCreateDevicesOrAssets": false,
  "defaultConverterId": null,
  "downlinkConverterId": null,
  "routingKey": null,
  "configuration": {
    "clientConfiguration": {
      "host": "${MONITORING:HOST}",
      "port": ${MONITORING:PORT},
      "cleanSession": true,
      "retainedMessage": false,
      "ssl": false,
      "connectTimeoutSec": 10,
      "clientId": "mon-int-${MONITORING:CLIENT_ID_SUFFIX}",
      "maxBytesInMessage": 32368,
      "protocolVersion": "MQTT_3_1_1",
      "credentials": {
        "type": "basic",
        "username": "${MONITORING:USERNAME}",
        "password": ""
      }
    },
    "topicFilters": [
      {
        "filter": "monitoring/${MONITORING:ROUTING_KEY}",
        "qos": 1
      }
    ],
    "downlinkTopicPattern": "${topic}",
    "metadata": {}
  },
  "additionalInfo": null,
  "edgeTemplate": false,
  "remote": false
}
