# See src/main/resources/tb-monitoring.yml for the full list of supported variables.

REST_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080
REST_AUTH_USERNAME=tenant@thingsboard.org
REST_AUTH_PASSWORD=tenant

MQTT_TRANSPORT_BASE_URL=tcp://localhost:1883
HTTP_TRANSPORT_BASE_URL=http://localhost:8080
COAP_TRANSPORT_BASE_URL=coap://localhost:5683
LWM2M_TRANSPORT_MONITORING_ENABLED=false

MONITORING_RATE_MS=10000

# JVM tuning (heap size, GC, etc.) - the java launcher itself reads this env var natively
# (JDK 9+), no wrapper script needed. Example:
# JDK_JAVA_OPTIONS=-Xmx256m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError
